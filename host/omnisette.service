[Unit]
Description=omnisette-server (local Anisette v3 server for iCloud Keychain)
Documentation=https://github.com/SideStore/omnisette-server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=%h/.local/share/icloud-keychain-for-linux/omnisette-server/target/release/omnisette-server --http-port 6969
WorkingDirectory=%h/.local/share/icloud-keychain-for-linux/omnisette-server
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
